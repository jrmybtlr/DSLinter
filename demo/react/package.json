{
  "name": "dslinter-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite-only": "vite",
    "dev:watch": "node ../../dashboard/bin/dslinter.mjs --watch --output public/dslinter-report.json",
    "dev:serve": "node ../../dashboard/bin/dslinter.mjs --serve 7878 --output public/dslinter-report.json",
    "build": "tsc && node ../../dashboard/bin/dslinter.mjs --build --output public/dslinter-report.json",
    "preview": "vite preview",
    "dslinter:report": "node scripts/gen-dslinter-report.mjs",
    "dslinter:merge-playgrounds": "node scripts/merge-playgrounds.mjs",
    "dslinter:watch": "node ../../dashboard/bin/dslinter.mjs --watch --output public/dslinter-report.json",
    "dslinter:serve": "node ../../dashboard/bin/dslinter.mjs --serve 7878 --output public/dslinter-report.json"
  },
  "dependencies": {
    "dslinter": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "wait-on": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
