{
  "name": "dslinter",
  "version": "0.8.0",
  "description": "Automatic React and Vue design-system explorer with live previews, controls, usage analytics, tokens, and governance.",
  "keywords": [
    "dashboard",
    "design-system",
    "dslinter",
    "governance",
    "react",
    "shadcn",
    "tailwind",
    "tailwindcss",
    "tokens"
  ],
  "homepage": "https://github.com/jrmybtlr/DSLinter#readme",
  "bugs": {
    "url": "https://github.com/jrmybtlr/DSLinter/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrmybtlr/DSLinter.git",
    "directory": "dashboard"
  },
  "bin": {
    "dslinter": "bin/dslinter.mjs"
  },
  "files": [
    "bin",
    "dashboard-dist",
    "embed",
    "index.html",
    "index.cjs",
    "index.d.ts",
    "src",
    "shared",
    "vite",
    "templates",
    "components.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/styles/dashboard-theme.css",
    "./vite": {
      "types": "./vite/plugin.ts",
      "default": "./vite/plugin.ts"
    },
    "./useclassy": {
      "types": "./vite/useClassy.ts",
      "default": "./vite/useClassy.ts"
    },
    "./playground-modules": {
      "types": "./src/playground/scanPlaygroundModules.ts",
      "default": "./src/playground/scanPlaygroundModules.ts"
    },
    "./mcp": {
      "types": "./src/mcp/start.ts",
      "default": "./src/mcp/start.ts"
    },
    "./preview": {
      "types": "./src/explorer/adapter.ts",
      "default": "./src/explorer/adapter.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:napi": "napi build --platform --release --cwd .. --output-dir dashboard --package-json-path dashboard/package.json --js-package-name @dslinter/binding --js index.cjs --no-default-features --features napi && node ../scripts/patch-napi-loader.mjs",
    "build:dashboard": "vite build",
    "artifacts": "napi artifacts --cwd .. --package-json-path dashboard/package.json --js-package-name @dslinter/binding",
    "test": "vitest run",
    "prepublishOnly": "vitest run && vite build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "usemods": "^1.16.0",
    "vite": "^7.3.5",
    "vite-plugin-useclassy": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  },
  "napi": {
    "binaryName": "dslinter",
    "flags": [
      "--no-default-features",
      "--features",
      "napi"
    ],
    "packageName": "@dslinter/binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
